{
  "name": "edible-shop",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=@edible-shop/frontend",
    "dev:backend": "npm run dev --workspace=@edible-shop/backend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@edible-shop/backend",
    "preview": "npm run preview --workspace=@edible-shop/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@edible-shop/backend",
    "clean": "npm run clean --workspaces --if-present",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate --workspace=@edible-shop/backend",
    "admin:create": "npm run admin:create --workspace=@edible-shop/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
