# PostgreSQL (use an available host port; container port remains 5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=edible_shop
POSTGRES_USER=edible_shop
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# API and browser origin
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000

# Flutterwave v3 test credentials. Keep all keys on the server.
PUBLIC_KEY=
SECRET_KEY=
ENCRYPTION_KEY=
# Set the same secret hash in your Flutterwave dashboard's Webhooks settings.
FLUTTERWAVE_WEBHOOK_SECRET=

# SMTP password-reset emails. Use an app password for Gmail, not your login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional administrator provisioning (npm run admin:create)
# Never commit real values here. Set these in your local .env for setup.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Optional deployment settings
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=true
# SESSION_COOKIE_SECURE=true

# Google OAuth Web Client ID (public; no client secret needed)
GOOGLE_CLIENT_ID=

# Additional exact browser origins, comma separated (no paths)
ALLOWED_ORIGINS=
